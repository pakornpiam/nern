{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nern: Run App",
      "type": "process",
      "command": "python",
      "args": [
        "server.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "detail": "Start Nern at http://localhost:5177"
    }
  ]
}
